rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra Global: Ninguém acessa nada por padrão (Fechado)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper para verificar se usuário autenticado é admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'edJdJPldLBftWCkP7ZqEghzEYL22' ||
        (exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Coleção: students (onde ficam os perfis de alunos, motoristas e admins)
    match /students/{userId} {
      allow read: if request.auth != null;
      // Novos cadastros públicos só podem criar como 'student'. Apenas admin pode criar outros papéis
      allow create: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId && request.resource.data.role == 'student')
      );
      // Admin pode atualizar qualquer campo inclusive 'role'; usuários normais não podem alterar seu próprio 'role'
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      allow delete: if isAdmin();
    }

    // Coleção: trips
    match /trips/{tripId} {
      allow read: if request.auth != null;
      // Qualquer usuário pode criar a viagem do dia se ela não existir
      allow create: if request.auth != null;
      // Motoristas e admins podem atualizar tudo; Alunos a bordo podem transmitir localização e metadados de ciclo de vida do GPS
      allow update: if request.auth != null && (
        isAdmin()
        || (exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role in ['driver', 'admin'])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'busLocation', 'locationProviderName', 'locationProviderId',
          'locationProviderRole', 'locationProviderStatus', 'locationUpdatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // Coleção: emergencies (Botão Fui Esquecido)
    match /emergencies/{emergencyId} {
      allow read: if request.auth != null;
      // O aluno só pode criar uma emergência no próprio nome
      allow create: if request.auth != null 
                    && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Coleção: attendance
    match /attendance/{attendanceId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Coleção: announcements (Mural de Avisos e Comunicados)
    match /announcements/{announcementId} {
      // Qualquer usuário autenticado pode ler comunicados
      allow read: if request.auth != null;
      // Apenas Admin ou Motoristas podem criar comunicados
      allow create: if request.auth != null && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'driver')
      );
      // Apenas Admin ou o próprio autor podem atualizar ou deletar
      allow update, delete: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.authorId
      );
    }
  }
}
